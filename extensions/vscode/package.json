{
  "name": "desenvolvimento-agentico-vscode",
  "displayName": "Desenvolvimento Agêntico",
  "description": "Governança, Missions, Runs e ciclo de vida do control plane de Desenvolvimento Agêntico dentro do VS Code.",
  "version": "0.1.0-alpha.1",
  "publisher": "desenvolvimento-agentico",
  "private": true,
  "preview": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EwaldoAFilho/desenvolvimento-agentico.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.134.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agentic",
    "orchestration",
    "control plane",
    "missions"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.agentic/project.yaml",
    "onView:agentic.status"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentic",
          "title": "Agentic",
          "icon": "resources/agentic.svg"
        }
      ]
    },
    "views": {
      "agentic": [
        {
          "id": "agentic.status",
          "name": "Projeto",
          "icon": "resources/agentic.svg",
          "contextualTitle": "Agentic"
        },
        {
          "id": "agentic.missions",
          "name": "Missions",
          "icon": "resources/agentic.svg",
          "contextualTitle": "Agentic"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentic.status",
        "contents": "Nenhum projeto Agentic detectado nesta janela.\n\nAbra uma pasta que contenha `.agentic/project.yaml` (ou rode `agentic init` nela).\n[Detectar de novo](command:agentic.refresh)",
        "when": "agentic.project == none"
      },
      {
        "view": "agentic.status",
        "contents": "Abra uma pasta para o Agentic detectar o projeto.\n[Abrir pasta](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      }
    ],
    "commands": [
      {
        "command": "agentic.start",
        "title": "Start Agentic",
        "category": "Agentic",
        "icon": "$(play)"
      },
      {
        "command": "agentic.stop",
        "title": "Stop Agentic",
        "category": "Agentic",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentic.restart",
        "title": "Restart Agentic",
        "category": "Agentic",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentic.open",
        "title": "Open Agentic",
        "category": "Agentic",
        "icon": "$(window)"
      },
      {
        "command": "agentic.refresh",
        "title": "Refresh",
        "category": "Agentic",
        "icon": "$(refresh)"
      },
      {
        "command": "agentic.openMission",
        "title": "Open Mission Details",
        "category": "Agentic"
      },
      {
        "command": "agentic.openMissionFile",
        "title": "Open Mission File",
        "category": "Agentic",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentic.openFile",
        "title": "Open File",
        "category": "Agentic"
      },
      {
        "command": "agentic.openDiff",
        "title": "Open Diff",
        "category": "Agentic"
      },
      {
        "command": "agentic.showLog",
        "title": "Show Agentic Log",
        "category": "Agentic",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentic.start",
          "when": "view == agentic.status && agentic.controlPlane != running",
          "group": "navigation@1"
        },
        {
          "command": "agentic.stop",
          "when": "view == agentic.status && agentic.controlPlane == running",
          "group": "navigation@1"
        },
        {
          "command": "agentic.restart",
          "when": "view == agentic.status && agentic.controlPlane == running",
          "group": "navigation@2"
        },
        {
          "command": "agentic.open",
          "when": "view == agentic.status",
          "group": "navigation@3"
        },
        {
          "command": "agentic.refresh",
          "when": "view == agentic.status || view == agentic.missions",
          "group": "navigation@4"
        },
        {
          "command": "agentic.showLog",
          "when": "view == agentic.status",
          "group": "2_log"
        }
      ],
      "view/item/context": [
        {
          "command": "agentic.openMissionFile",
          "when": "view == agentic.missions && viewItem == mission",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "agentic.openMission",
          "when": "false"
        },
        {
          "command": "agentic.openMissionFile",
          "when": "false"
        },
        {
          "command": "agentic.openFile",
          "when": "false"
        },
        {
          "command": "agentic.openDiff",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agentic",
      "properties": {
        "agentic.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Caminho do executável `agentic` (CLI). Vazio = detectar: `apps/cli/bin/agentic.mjs` no repositório, `node_modules/.bin/agentic`, depois o `PATH`."
        },
        "agentic.nodePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Caminho do `node` (>= 22) usado para subir o control plane. Vazio = detectar no `PATH` e nas instalações do nvm."
        },
        "agentic.stopOnWindowClose": {
          "type": "boolean",
          "default": true,
          "description": "Ao fechar esta janela, encerrar graciosamente o control plane que ELA iniciou. Um control plane iniciado por outra janela ou pelo terminal nunca é tocado."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project vscode-extension",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && vsce package --no-dependencies --out ../../desenvolvimento-agentico-vscode-0.1.0-alpha.1.vsix",
    "test:integration": "node test/run.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.0",
    "esbuild": "^0.28.0"
  }
}
