{
  "name": "desenvolvimento-agentico",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control plane para engenharia de software agentica.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "agentic": "apps/cli/bin/agentic.mjs"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run --project=!e2e",
    "test:watch": "vitest",
    "test:e2e": "vitest run --project e2e",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "dev:web": "npm run dev -w @agentic/web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EwaldoAFilho/desenvolvimento-agentico.git"
  }
}
